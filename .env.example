# CORS Proxy for Yahoo Finance data (required for production)
# Deploy your own Cloudflare Worker to proxy Yahoo Finance requests.
# In development, Vite proxies these automatically — this is only needed for production builds.
# See README.md for a minimal Cloudflare Worker example.
VITE_CORS_PROXY_URL=https://your-worker.your-subdomain.workers.dev

# API Base URL (required for production builds if you host the frontend
# separately from the API, e.g. frontend on Firebase + API on Vercel)
# Without this, the news panel and AI chat proxy call a relative /api/v1/...
# path on the frontend's own domain, which doesn't exist there — you'll get
# "Unexpected token '<' ... is not valid JSON" errors in production.
# In development, the Vite plugin serves the API locally — leave this empty
# there, or put it in .env.production instead of .env.local so it only
# applies to `npm run build`.
# VITE_API_BASE_URL=https://your-api-deployment.vercel.app
